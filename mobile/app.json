{
  "expo": {
    "name": "Stream Engine AI",
    "slug": "stream-engine-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "streamengineai",
    "ios": {
      "bundleIdentifier": "com.yungaires.streamengineai",
      "supportsTablet": true,
      "infoPlist": {
        "NSUserTrackingUsageDescription": "Tracking permission is requested only if needed for relevant advertising."
      }
    },
    "android": {
      "package": "com.yungaires.streamengineai",
      "permissions": [
        "INTERNET"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#090b14"
      }
    },
    "plugins": [
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ],
    "extra": {
      "eas": {}
    }
  }
}
