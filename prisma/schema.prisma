generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  displayName  String?
  createdAt    DateTime   @default(now())
  campaigns    Campaign[]
  tiktokAccessTokenEnc String?
  tiktokRefreshTokenEnc String?
  tiktokTokenExpiresAt DateTime?
  tiktokOpenId String?
  tiktokScopes String?
  tiktokUsername String?
  growthExperiments GrowthExperiment[]
}

model Campaign {
  id             String          @id @default(cuid())
  userId         String
  title          String
  songUrl        String
  genre          String?
  brief          String?
  createdAt      DateTime        @default(now())
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  videos         VideoAsset[]
  scheduledPosts ScheduledPost[]
}

model VideoAsset {
  id         String   @id @default(cuid())
  campaignId String
  concept    String
  hook       String   @default("")
  script     String   @default("")
  videoPrompt String @default("")
  caption    String
  hashtags   String
  status     String   @default("IDEA")
  videoPath  String?
  videoStatus String @default("NOT_STARTED")
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model ScheduledPost {
  id          String   @id @default(cuid())
  campaignId  String
  scheduledAt DateTime
  caption     String
  status      String   @default("DRAFT_AWAITING_TIKTOK_AUTH")
  createdAt   DateTime @default(now())
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  @@index([scheduledAt, status])
}

model GrowthExperiment {
 id String @id @default(cuid())
 userId String
 channel String
 spend Float @default(0)
 clicks Int @default(0)
 saves Int @default(0)
 newListeners Int @default(0)
 notes String?
 createdAt DateTime @default(now())
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 @@index([userId,createdAt])
}
