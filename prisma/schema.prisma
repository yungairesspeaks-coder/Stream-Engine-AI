generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  displayName  String?
  loginCount   Int        @default(0)
  lastLoginAt  DateTime?
  promotionCampaigns PromotionCampaign[]
  createdAt    DateTime   @default(now())
  campaigns    Campaign[]
  growthExperiments GrowthExperiment[]
  playlistCandidates PlaylistCandidate[]
  rewardLedger SponsorRewardLedger[]
  campaignCredits SponsorCampaignCredit[]
  spotifyAdsConnection SpotifyAdsConnection?
}

model Campaign {
  id             String          @id @default(cuid())
  userId         String
  title          String
  songUrl        String
  genre          String?
  brief          String?
  createdAt      DateTime        @default(now())
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  videos         VideoAsset[]
  scheduledPosts ScheduledPost[]
}

model VideoAsset {
  id         String   @id @default(cuid())
  campaignId String
  concept    String
  hook       String   @default("")
  script     String   @default("")
  videoPrompt String @default("")
  caption    String
  hashtags   String
  status     String   @default("IDEA")
  videoPath  String?
  videoStatus String @default("NOT_STARTED")
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model ScheduledPost {
  id          String   @id @default(cuid())
  campaignId  String
  scheduledAt DateTime
  caption     String
  status      String   @default("PROMO_DRAFT_READY")
  createdAt   DateTime @default(now())
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  @@index([scheduledAt, status])
}

model GrowthExperiment {
 id String @id @default(cuid())
 userId String
 channel String
 spend Float @default(0)
 clicks Int @default(0)
 saves Int @default(0)
 newListeners Int @default(0)
 notes String?
 createdAt DateTime @default(now())
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 @@index([userId,createdAt])
}

model PlaylistCandidate {
 id String @id @default(cuid())
 userId String
 title String
 trackUrl String
 releaseDate DateTime
 genre String
 mood String
 description String
 marketingPlan String
 score Int @default(0)
 targetsJson String
 pitchDraft String
 status String @default("DRAFT")
 createdAt DateTime @default(now())
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 @@index([userId,score])
}


model SponsorAd {
  id String @id @default(cuid())
  title String
  sponsorName String
  videoUrl String
  rewardCredits Int
  active Boolean @default(true)
  startsAt DateTime @default(now())
  endsAt DateTime?
  createdAt DateTime @default(now())
  ledger SponsorRewardLedger[]
  @@index([active, startsAt])
}

model SponsorRewardLedger {
  id String @id @default(cuid())
  userId String
  sponsorAdId String?
  type String
  deltaCredits Int
  providerEventId String? @unique
  note String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sponsorAd SponsorAd? @relation(fields: [sponsorAdId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
}

model SponsorCampaignCredit {
  id String @id @default(cuid())
  userId String
  credits Int
  status String @default("AVAILABLE")
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, status])
}

model SpotifyAdsConnection {
  id String @id @default(cuid())
  userId String @unique
  accessTokenEnc String
  refreshTokenEnc String
  expiresAt DateTime
  selectedAdAccountId String?
  selectedBusinessId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model PromotionCampaign {
  id String @id @default(cuid())
  userId String
  campaignType String
  title String
  songUrl String
  trackId String
  trackName String?
  artistName String?
  albumImageUrl String?
  creditsRequested Int
  status String @default("PENDING")
  statusReason String?
  spotifyCampaignId String?
  metricsJson String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, status, createdAt])
}
